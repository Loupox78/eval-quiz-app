# Modèle Nginx : ${BACKEND_HOST} est remplacé au démarrage du conteneur
# (mécanisme envsubst intégré à l'image officielle Nginx).
#   - en local (Compose) : BACKEND_HOST=backend:3007
#   - sur Azure Container Apps : BACKEND_HOST=quiz-backend (ingress interne, port 80)

server {
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;

    # Main app
    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Admin page - serve gestion-quiz.html for /gestion-quiz route
    location = /gestion-quiz {
        try_files /gestion-quiz.html =404;
    }

    # API proxy to backend
    location /api/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        # Host = nom du backend : indispensable sur Azure, où le routage interne se fait par nom d'hôte
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host ${BACKEND_HOST};
    }
}
