# Copier en .env.azure (non versionné) et remplir. Utilisé par : ./scripts/deploy.sh apps
# Ne JAMAIS committer le vrai fichier. Mettre entre guillemets les valeurs contenant espaces ou < >.

# Chaîne PostgreSQL cloud (Neon), avec TLS obligatoire et vérification du certificat :
#   DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=verify-full"
# (copier la chaîne fournie par Neon et remplacer sslmode=require par sslmode=verify-full)
# Pour J4 sans base, une valeur factice suffit (le backend démarre, /health répond) :
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder

# Clé Resend (obligatoire pour que le backend démarre ; factice = pas d'envoi de mail)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL="Quiz App <noreply@votredomaine.com>"

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-long-random-string
